# NATI Commerce Environment Variables
# Copy this file to .env and fill in your values

# --------------------------
# DATABASE
# --------------------------
DATABASE_URL=postgresql://nati_user:password@localhost:5432/nati_commerce
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --------------------------
# REDIS
# --------------------------
REDIS_URL=redis://localhost:6379

# --------------------------
# JWT & AUTH
# --------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-change-this

# --------------------------
# GOOGLE CLOUD
# --------------------------
GOOGLE_CLOUD_PROJECT_ID=nati-commerce
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCS_BUCKET_NAME=nati-commerce-assets

# --------------------------
# GOOGLE GEMINI AI
# --------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# --------------------------
# AI GATEWAY
# --------------------------
AI_GATEWAY_URL=http://localhost:8000
OPENAI_API_KEY=your-openai-api-key-fallback
ANTHROPIC_API_KEY=your-anthropic-api-key-fallback

# --------------------------
# PAYMENTS
# --------------------------
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# --------------------------
# SHIPPING
# --------------------------
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password

# --------------------------
# EMAIL & SMS
# --------------------------
KLAVIYO_API_KEY=your-klaviyo-api-key
KLAVIYO_PRIVATE_KEY=your-klaviyo-private-key
RESEND_API_KEY=your-resend-api-key
GUPSHUP_API_KEY=your-gupshup-api-key

# --------------------------
# CMS
# --------------------------
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-token

# --------------------------
# ANALYTICS
# --------------------------
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
META_PIXEL_ID=your-meta-pixel-id
AMPLITUDE_API_KEY=your-amplitude-key

# --------------------------
# MONITORING
# --------------------------
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# --------------------------
# FRONTEND
# --------------------------
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# --------------------------
# MEDUSA
# --------------------------
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_ADMIN_ONBOARDING_FLOW=default
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
